.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ── 顶部 ─────────────────────────────────────────────── */

.head {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0 18rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.head-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.head-btn {
  padding: 10rpx 22rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  color: var(--text-2);
  background: var(--surface-2);
}

.head-btn-busy {
  color: var(--primary);
}

/* ── tab ──────────────────────────────────────────────── */

.tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 14rpx;
  font-size: 25rpx;
  color: var(--text-2);
  background: var(--surface);
}

.tab-on {
  background: rgba(143, 169, 143, 0.16);
  color: var(--primary);
  font-weight: 600;
}

/* ── 指标卡 ───────────────────────────────────────────── */

.stats {
  display: flex;
  gap: 10rpx;
}

.stat {
  flex: 1;
  padding: 22rpx 16rpx;
  border-radius: 18rpx;
  background: var(--surface);
  text-align: center;
  border: 1rpx solid transparent;
}

/* 可点的那张给个边框提示 */
.stat-on {
  background: rgba(143, 169, 143, 0.12);
  border-color: rgba(143, 169, 143, 0.32);
}

.stat-label {
  font-size: 21rpx;
  color: var(--text-3);
}

.stat-value {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}

/* ── 学分构成 ─────────────────────────────────────────── */

.credit {
  margin-top: 16rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
  border-radius: 20rpx;
  background: var(--surface);
}

.credit-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.credit-title {
  font-size: 28rpx;
  font-weight: 600;
}

.credit-chips {
  display: flex;
  gap: 4rpx;
}

.credit-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.credit-row {
  margin-top: 20rpx;
}

.credit-row-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.credit-label {
  font-size: 24rpx;
  color: var(--text-2);
  max-width: 70%;
}

.credit-num {
  font-size: 24rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.credit-note {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: var(--text-3);
  opacity: 0.85;
}

/* ── 学期分组 ─────────────────────────────────────────── */

.term-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 4rpx 12rpx;
}

.term-name {
  font-size: 27rpx;
  font-weight: 600;
}

.term-sub {
  font-size: 21rpx;
  color: var(--text-3);
}

.grade-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: var(--surface);
  margin-bottom: 8rpx;
}

.grade-row:active {
  opacity: 0.8;
}

.grade-name {
  font-size: 27rpx;
  line-height: 1.35;
}

.grade-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.grade-dot {
  margin: 0 8rpx;
  opacity: 0.5;
}

.grade-score {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.grade-fail {
  color: var(--danger);
}

/* ── 考级 ─────────────────────────────────────────────── */

.level-card {
  margin-bottom: 16rpx;
}

.lv-name {
  font-size: 29rpx;
  font-weight: 600;
}

.lv-total {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}

.lv-meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

.lv-parts {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.lv-part {
  flex: 1;
  min-width: 120rpx;
  padding: 14rpx 10rpx;
  border-radius: 12rpx;
  background: var(--surface-2);
  text-align: center;
}

.lv-part-label {
  font-size: 19rpx;
  color: var(--text-3);
}

.lv-part-value {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* ── 体测 ─────────────────────────────────────────────── */

.fit-card {
  margin-bottom: 16rpx;
}

.fit-term {
  font-size: 27rpx;
  font-weight: 600;
}

.fit-total {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}

.fit-level {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-2);
}

.fit-row {
  display: flex;
  align-items: center;
  padding: 11rpx 0;
}

/* 关键：标签固定宽度，数值紧贴标签，
   不和分数抢位置 —— Android 版这里出过「172体重」挤在一起的问题 */
.fit-label {
  flex-shrink: 0;
  width: 190rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.fit-value {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.fit-score {
  flex: 1;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

.tail {
  height: 24rpx;
}