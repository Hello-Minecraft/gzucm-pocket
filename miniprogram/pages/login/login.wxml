<!--
  登录页。

  只做扫码登录。为什么不做密码登录：
    · 密码要经过小程序，而 Android 版是「用户在 WebView 里输给学校页面」，
      App 从不接触密码。小程序做不到这一点，是产品的降级。
    · 扫码全程 HTTP，不需要 WebView，是唯一等价的方式。

  交互：出码 → 用户拿另一台设备扫 → 轮询 → 成功即进首页。
-->
<view class="page">
  <view class="safe-top"></view>

  <view class="wrap">
    <!-- 标题区 -->
    <view class="brand">
      <view class="brand-mark">口</view>
      <view class="brand-name">广中医口袋</view>
      <view class="brand-sub">微信小程序版</view>
    </view>

    <!-- 二维码区 -->
    <view class="qr-box">
      <!-- 正常态：画码 -->
      <block wx:if="{{state === 'waiting' || state === 'scanned'}}">
        <canvas
          wx:if="{{qrReady}}"
          type="2d"
          id="qr"
          class="qr-canvas {{state === 'scanned' ? 'qr-blur' : ''}}"
        ></canvas>
        <view wx:if="{{!qrReady}}" class="qr-loading">正在生成二维码…</view>
      </block>

      <!-- 加载 / 失败 / 过期 -->
      <view wx:if="{{state === 'loading'}}" class="qr-loading">正在获取二维码…</view>

      <view wx:if="{{state === 'expired'}}" class="qr-fail">
        <view class="qr-fail-icon">⌛</view>
        <view class="qr-fail-text">二维码已过期</view>
      </view>

      <view wx:if="{{state === 'error'}}" class="qr-fail">
        <view class="qr-fail-icon">⚠</view>
        <view class="qr-fail-text">{{errorText || '获取二维码失败'}}</view>
      </view>

      <!-- 已扫码未确认的覆盖层 -->
      <view wx:if="{{state === 'scanned'}}" class="qr-cover">
        <view class="qr-cover-icon">✓</view>
        <view class="qr-cover-text">扫描成功</view>
        <view wx:if="{{scannedWho}}" class="qr-cover-who">{{scannedWho}}</view>
        <view class="qr-cover-hint">请在微信里点击「确认登录」</view>
      </view>
    </view>

    <!-- 步骤说明 -->
    <view class="steps">
      <view class="step">
        <view class="step-num">1</view>
        <view class="step-text">用<text class="em">另一台手机</text>的微信扫上面的码</view>
      </view>
      <view class="step">
        <view class="step-num">2</view>
        <view class="step-text">在微信里点「确认登录」</view>
      </view>
      <view wx:if="{{state === 'scanned'}}" class="step step-done">
        <view class="step-num">3</view>
        <view class="step-text">正在等你在微信里确认…</view>
      </view>
    </view>

    <!-- 提示 -->
    <view class="tips">
      <view class="tips-title">为什么要用另一台设备</view>
      <view class="tips-body">
        学校的扫码登录要跳进微信的网页完成确认，小程序里做不了这一步。
        所以得用另一台手机扫 —— 就像在电脑上登录微信一样。
      </view>
    </view>

    <view class="tips tips-warn">
      <view class="tips-title">关于你的账号</view>
      <view class="tips-body">
        不保存密码，也不在云端保存登录凭据。
        登录成功后拿到的会话只存在你自己手机的本地存储里，
        请求时随请求带走，用完即弃。
      </view>
    </view>

    <!-- 操作 -->
    <view class="actions">
      <view wx:if="{{state === 'expired' || state === 'error'}}" class="btn btn-primary" bindtap="refreshQr">
        重新获取二维码
      </view>
      <view wx:if="{{state === 'waiting' || state === 'scanned'}}" class="btn btn-ghost" bindtap="refreshQr">
        换一张
      </view>
    </view>

    <view class="foot">不是官方应用 · 个人做的工具</view>
  </view>
</view>