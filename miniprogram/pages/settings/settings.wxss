.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.nav {
  padding-top: 8rpx;
  padding-bottom: 4rpx;
}

.nav-back {
  display: inline-block;
  padding: 10rpx 20rpx 10rpx 8rpx;
  font-size: 27rpx;
  color: var(--primary);
}

.nav-back:active {
  opacity: 0.7;
}

.head {
  padding: 8rpx 4rpx 26rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.head-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

/* ── 分组 ─────────────────────────────────────────────── */

.group-label {
  padding: 26rpx 8rpx 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}

/* ── 行 ───────────────────────────────────────────────── */

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.row + .row {
  border-top: 1rpx solid var(--line);
}

.row:active {
  opacity: 0.85;
}

.row-label {
  font-size: 27rpx;
  color: var(--text);
}

.row-label-danger {
  color: var(--danger);
}

.row-desc {
  margin-top: 5rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--text-3);
}

.row-value {
  font-size: 24rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}

.row-slider {
  align-items: flex-start;
}

/* ── chip 组 ──────────────────────────────────────────── */

.chips {
  display: flex;
  gap: 6rpx;
  flex-shrink: 0;
}

/* ── slider ───────────────────────────────────────────── */

.slider {
  width: 320rpx;
  margin: 0;
  flex-shrink: 0;
}

/* ── 按钮 ─────────────────────────────────────────────── */

.btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.2;
}

.btn-danger {
  color: var(--danger);
  border-color: rgba(201, 122, 109, 0.4);
}

/* ── 说明 ─────────────────────────────────────────────── */

.note {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(201, 168, 109, 0.08);
  border: 1rpx solid rgba(201, 168, 109, 0.18);
  font-size: 20rpx;
  line-height: 1.7;
  color: var(--text-3);
}

.about-body {
  margin-top: 0;
  line-height: 1.7;
}

.tail {
  height: 40rpx;
}