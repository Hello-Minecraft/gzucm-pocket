/**
 * 全局样式与主题变量。
 *
 * 配色取自 Android 版：深色底 + 灰绿强调色（原图标底 rgb(67,85,74) 一系）。
 * 小程序没有 Material 的 colorScheme，这里用 CSS 变量手搓一套。
 */

page {
  --bg: #121613;
  --surface: #1B211D;
  --surface-2: #232A25;
  --surface-3: #2C342E;
  --line: #333C36;

  --primary: #8FA98F;
  --primary-dim: #5C735C;
  --on-primary: #10240F;
  --secondary: #7C8FA9;
  --danger: #C97A6D;
  --warn: #C9A86D;

  --text: #E4EAE4;
  --text-2: #A8B4AB;
  --text-3: #6E7A72;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, Arial,
    "Microsoft YaHei", sans-serif;
  line-height: 1.4;
}

view,
text,
scroll-view {
  box-sizing: border-box;
}

/* ── 通用容器 ──────────────────────────────────────────── */

.page {
  min-height: 100vh;
  background: var(--bg);
}

.pad {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

/* 顶部留给状态栏 + 标题 */
.safe-top {
  padding-top: calc(env(safe-area-inset-top) + 16rpx);
}

/* 底部留给 tabBar */
.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ── 卡片 ──────────────────────────────────────────────── */

.card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
}

.card + .card {
  margin-top: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

/* ── 文字 ──────────────────────────────────────────────── */

.t1 {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.t2 {
  font-size: 32rpx;
  font-weight: 600;
}

.t3 {
  font-size: 28rpx;
  color: var(--text-2);
}

.t4 {
  font-size: 24rpx;
  color: var(--text-3);
}

.mute {
  color: var(--text-2);
}

.dim {
  color: var(--text-3);
}

.mono {
  font-variant-numeric: tabular-nums;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 两行截断 */
.clamp2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── 行 ────────────────────────────────────────────────── */

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

/* ── 按钮 ──────────────────────────────────────────────── */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  height: 68rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  background: var(--surface-3);
  color: var(--text);
}

.btn-primary {
  background: var(--primary);
  color: var(--on-primary);
  font-weight: 600;
}

.btn-ghost {
  background: transparent;
  border: 1rpx solid var(--line);
  color: var(--text-2);
}

.btn:active {
  opacity: 0.75;
}

/* ── 标签 ──────────────────────────────────────────────── */

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  color: var(--text-2);
  background: transparent;
}

.chip-on {
  background: rgba(143, 169, 143, 0.16);
  color: var(--primary);
  font-weight: 600;
}

/* ── 分隔 ──────────────────────────────────────────────── */

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

/* ── 空态 ──────────────────────────────────────────────── */

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 64rpx;
  opacity: 0.35;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-2);
}

.empty-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

/* ── 加载 ──────────────────────────────────────────────── */

.loading {
  padding: 100rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

/* 细进度条 */
.progress {
  height: 4rpx;
  background: var(--line);
  border-radius: 2rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: var(--primary);
  transition: width 0.25s ease;
}