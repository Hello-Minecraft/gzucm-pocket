<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

        <!--
      应用内更新：下完直接调起安装器（2026-11-23）。
      Android 8 起这个权限本身不弹窗，只是「能不能发起安装」的开关，
      真正要用户手动开的是系统设置里的「允许安装未知应用」（见 ApkInstaller）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

<uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 今日页拖动排序长按抓手时的那一下「嗒」。普通权限，装好就有，不弹窗 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        天气地点里的「使用当前位置」。

        ## 为什么 COARSE 和 FINE 都要声明

        功能上只需要粗略定位：天气按 0.01°（约 1 公里）取格点，精确到街道毫无意义。

        但**只声明 COARSE 时，部分国产 ROM（实测 HyperOS / MIUI 的机型）的
        定位回调压根不触发**：系统状态栏的定位图标亮了，说明请求确实发出去了，
        回调却永远不来，最后只能超时。这是 OEM 对「大致位置」请求的实现问题 ——
        它拿不到满足内部精度要求的定位时既不给结果也不报错。

        所以 FINE 在这里是**为了让回调能回来**，不是为了提高精度：
        Android 12+ 的弹窗由用户自己选「精确 / 大致」，选「大致」时系统只给
        COARSE 精度的坐标，功能一切正常（我们本来就只用这一级精度）。

        ## 申请时机不变

        这个权限**不会在启动时申请**：只有用户在设置里点「使用当前位置」的那一刻，
        才通过 RequestMultiplePermissions 弹窗（见 ui/settings/WeatherPlaceSheet.kt）。
        拿到 COARSE 就算通过（FINE 被拒不影响使用）；两个权限认一个即可。
        坐标只写本机 SharedPreferences，不上传、不写日志。

        仍然不要加 ACCESS_BACKGROUND_LOCATION：退出 App 后还能定位 ——
        这个功能一次都不需要。
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Android 11 起 App 默认看不到别的包。

        「智慧宿管」这类只能企业微信打开的服务，要靠 wxwork:// 把用户送过去 ——
        不声明这一条，startActivity 会以为没人能处理，直接失败。
    -->
    <queries>
        <package android:name="com.tencent.wework" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.GzucmPocket">

        <!--
            学校服务的全屏网页。独立 Activity 而不是弹窗：网页要上下滑动，
            挂在 ModalBottomSheet 上时「翻页」和「下拉关闭」是同一个手势，
            一划就把页面关了（2026-11-21 致辉报的）。
        -->
        <activity
            android:name=".ui.workbench.CampusWebActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.GzucmPocket" />

        <!--
            学委教程页。独立 Activity 而不是弹窗/底部面板：正文有七节，
            挂在面板上时「往下读」和「下拉关闭」是同一个手势，手一滑就没了。
        -->
        <activity
            android:name=".ui.schedule.ClassPlanGuideActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.GzucmPocket" />

        <!--
            班级日程（学委维护 + 同学认领）。2026-11-23 从底部面板 / 居中弹窗
            改成整页：编辑页有输入框和日期选择器，面板被往下带一下就把输入全丢了；
            详情页要翻几十行条目，「往下翻」和「下拉关面板」又是同一个手势。
            adjustResize：编辑页底部有输入框，键盘弹起时要顶上去而不是盖住保存按钮。
        -->
        <activity
            android:name=".ui.schedule.ClassPlanActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.GzucmPocket" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.GzucmPocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    
        <receiver
            android:name=".core.ClassReminderReceiver"
            android:exported="false" />

        <!-- 日程提醒：和课程提醒并列的独立 Receiver（隔离见 AgendaReminder 的注释） -->
        <receiver
            android:name=".core.AgendaReminderReceiver"
            android:exported="false" />

        <!-- 每日天气提醒（早晨温差 / 晚间带伞）。两条闹钟共用这一个 Receiver，
             kind 由 Intent extra 区分 -->
        <receiver
            android:name=".core.WeatherAlertReceiver"
            android:exported="false" />

        <!--
          导出课表 JSON：把 cache/exports/ 下的文件以 content:// 交给系统分享。

          为什么需要它：Android 7 起直接 `file://` 分享会抛
          FileUriExposedException，必须换成 FileProvider 给的 content:// URI。
          exported=false + grantUriPermissions=true 是标准组合 —— 只有拿到
          FLAG_GRANT_READ_URI_PERMISSION 的接收方读得到，别的一概不行。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          时间类广播（TIME_SET / TIMEZONE_CHANGED / DATE_CHANGED）是系统豁免清单里的，
          targetSdk 26+ 依然能用清单静态注册收到，不需要常驻进程。
        -->
        <receiver
            android:name=".core.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

</application>

</manifest>
