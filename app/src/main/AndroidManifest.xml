<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 今日页拖动排序长按抓手时的那一下「嗒」。普通权限，装好就有，不弹窗 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Android 11 起 App 默认看不到别的包。

        「智慧宿管」这类只能企业微信打开的服务，要靠 wxwork:// 把用户送过去 ——
        不声明这一条，startActivity 会以为没人能处理，直接失败。
    -->
    <queries>
        <package android:name="com.tencent.wework" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.GzucmPocket">

        <!--
            学校服务的全屏网页。独立 Activity 而不是弹窗：网页要上下滑动，
            挂在 ModalBottomSheet 上时「翻页」和「下拉关闭」是同一个手势，
            一划就把页面关了（2026-11-21 致辉报的）。
        -->
        <activity
            android:name=".ui.workbench.CampusWebActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.GzucmPocket" />

        <!--
            学委教程页。独立 Activity 而不是弹窗/底部面板：正文有七节，
            挂在面板上时「往下读」和「下拉关闭」是同一个手势，手一滑就没了。
        -->
        <activity
            android:name=".ui.schedule.ClassPlanGuideActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.GzucmPocket" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.GzucmPocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    
        <receiver
            android:name=".core.ClassReminderReceiver"
            android:exported="false" />

        <!-- 日程提醒：和课程提醒并列的独立 Receiver（隔离见 AgendaReminder 的注释） -->
        <receiver
            android:name=".core.AgendaReminderReceiver"
            android:exported="false" />

        <!--
          导出课表 JSON：把 cache/exports/ 下的文件以 content:// 交给系统分享。

          为什么需要它：Android 7 起直接 `file://` 分享会抛
          FileUriExposedException，必须换成 FileProvider 给的 content:// URI。
          exported=false + grantUriPermissions=true 是标准组合 —— 只有拿到
          FLAG_GRANT_READ_URI_PERMISSION 的接收方读得到，别的一概不行。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          时间类广播（TIME_SET / TIMEZONE_CHANGED / DATE_CHANGED）是系统豁免清单里的，
          targetSdk 26+ 依然能用清单静态注册收到，不需要常驻进程。
        -->
        <receiver
            android:name=".core.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

</application>

</manifest>
