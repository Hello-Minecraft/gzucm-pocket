<?xml version="1.0" encoding="utf-8"?>
<!--
    4x3 三天课表：今天 / 明天 / 后天三列。和时间轴是**两个独立部件**，各自一条 receiver。

    尺寸 250×180dp = 4×3 格。上一版是 250×250（4×4），三列只有两条课的时候
    下半屏全是空白；降到 3 格高、内容顶部对齐、列内可滚，空的部分就不再撑开了。
    只用 minWidth/minHeight，不写 targetCell*（见 widget_current_info.xml）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_three_days"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:previewLayout="@layout/widget_three_days"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
