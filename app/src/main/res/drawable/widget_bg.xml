<?xml version="1.0" encoding="utf-8"?>
<!--
    部件背景。

    圆角**自己画**：小米（HyperOS）桌面不会替三方部件裁圆角，
    在 Pixel 上验收很容易被掩盖 —— 真机必须看小米/OPPO。

    24dp（v3 设计稿）：比 Android 12+ 的 system_app_widget_background_radius
    （16dp）更圆一档，和课程胶囊的弧度呼应；110dp 的部件上正好是 3.8mm。
    颜色走 @color/widget_bg，深色由 values-night 提供，
    不在代码里判断深浅色。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bg" />
    <corners android:radius="24dp" />
</shape>
