<?xml version="1.0" encoding="utf-8"?>
<!--
    4x2 今日课程：表头 + 两张胶囊卡（各 34dp）。

    和 2x2 同一套版式，多出来的宽度放两列次要信息：
        · 10:20  中医骨伤科学        综教808   张伟
    地点用「次」色、老师用「弱」色 —— 老师比地点更淡一档，扫视时先看到教室。

    地点 / 老师为空时整栏由 Kotlin 收掉（老快照没有 teacher 字段），
    不会留一条空白把课名挤窄。

    第三档圆角用 b（16dp）：34dp 高的胶囊，radius 被 clamp 成半高。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dim"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/widget_refresh"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/c1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_kb1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <FrameLayout
                android:id="@+id/c1_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/widget_dot1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/c1_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_dim"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/c1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/c1_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:maxWidth="72dp"
                    android:textColor="@color/widget_text_dim"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/c1_teacher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:maxWidth="72dp"
                    android:textColor="@color/widget_text_weak"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/c2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_kb1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <FrameLayout
                android:id="@+id/c2_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/widget_dot1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/c2_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_dim"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/c2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/c2_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:maxWidth="72dp"
                    android:textColor="@color/widget_text_dim"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/c2_teacher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:maxWidth="72dp"
                    android:textColor="@color/widget_text_weak"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/widget_text_weak"
        android:textSize="11sp"
        android:visibility="gone" />
</FrameLayout>
