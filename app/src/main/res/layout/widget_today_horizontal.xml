<?xml version="1.0" encoding="utf-8"?>
<!--
    4x2 今日横排：今天的课横向排开，最多 5 块，超出折成「还有 N 节」。

    5 块是为了在 250dp 宽度里让每块还有约 45dp（4 个汉字）—— 再切细就只能
    显示两个字，失去意义。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_refresh"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/widget_blocks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/hb1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_block"
                android:orientation="vertical"
                android:padding="5dp">

                <TextView
                    android:id="@+id/hb1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/widget_block_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/hb1_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_block_text"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hb2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_block"
                android:orientation="vertical"
                android:padding="5dp">

                <TextView
                    android:id="@+id/hb2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/widget_block_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/hb2_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_block_text"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hb3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_block"
                android:orientation="vertical"
                android:padding="5dp">

                <TextView
                    android:id="@+id/hb3_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/widget_block_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/hb3_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_block_text"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hb4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_block"
                android:orientation="vertical"
                android:padding="5dp">

                <TextView
                    android:id="@+id/hb4_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/widget_block_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/hb4_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_block_text"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hb5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_block"
                android:orientation="vertical"
                android:padding="5dp">

                <TextView
                    android:id="@+id/hb5_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/widget_block_text"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/hb5_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_block_text"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
