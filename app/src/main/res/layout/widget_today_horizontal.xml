<?xml version="1.0" encoding="utf-8"?>
<!--
    4x2 今日课程：**上下两张卡片**，和 2x2 同一套版式，只是横向宽、多两列。

    上一版是横排 5 个窄块，每块约 45dp，课名只能看到 3 个字。现在一行放得下
    节次时间 / 课名 / 地点 / 老师四段：

        · 08:30
          09:40   外科学(2)      综教808   张伟
        ─────────────────────────────────────
        · 10:20
          11:00   中医骨伤科学   新课室202  李娜

    列宽固定：时间 46dp / 课名 flex / 地点 60dp / 老师 34dp。
    地点和老师为空时（老快照没有 teacher 字段）由 Kotlin 隐藏那一栏，
    不会留一条空白。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="9sp" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/widget_refresh"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/c1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_block"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/c1_start"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/c1_end"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:textColor="@color/widget_text_dim"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/c1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/c1_room"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dim"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/c1_teacher"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dim"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/c2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:background="@drawable/widget_block"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/c2_start"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/c2_end"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:textColor="@color/widget_text_dim"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/c2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/c2_room"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dim"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/c2_teacher"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dim"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 今天课都上完了 / 周末：两张卡合并成一句话 -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_text_dim"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
