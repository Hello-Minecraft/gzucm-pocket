<?xml version="1.0" encoding="utf-8"?>
<!--
    4x4 今日时间轴：1-12 节纵向排开，右侧课程块。

    12 行固定写在 XML 里（RemoteViews 不能用 RecyclerView / 动态 addView）。
    节次号和开始时间在绑定时从 SlotTimes 填，避免和 core 里的作息表脱钩。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
