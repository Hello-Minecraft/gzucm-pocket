<?xml version="1.0" encoding="utf-8"?>
<!--
    4x4 今日课程：**节次列表**（最多 7 条）。

    上一版是 12 行时间轴：节次号 + 着色块 + 时间，只有两条课的时候
    12 行 layout_weight 均分高度，空白被撑得比内容还多；6sp 的时间也看不清。
    现在一行就是一条课，四列对齐，字号比 4x2 大一号（课名 12sp）：

        1-2  08:30  外科学(2)       综教808
        3-4  10:20  中医骨伤科学    新课室202

    行高固定 26dp：多出来的高度留在底部，不参与分配。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@string/widget_refresh"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tl1"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_block"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tl1_unit"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_block_text"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tl1_time"
            android:layout_width="34dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_block_text"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tl1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_block_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tl1_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:maxWidth="76dp"
            android:textColor="@color/widget_block_text"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
