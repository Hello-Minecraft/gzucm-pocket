<?xml version="1.0" encoding="utf-8"?>
<!--
    4x4 今日课程：表头 + **今天全部课**（最多 7 行，超出的折成「还有 N 节」）。

    一行就是一门课，不再是 12 节的空时间轴 —— 只有两节课时，12 行均分高度会
    把空白撑得比字还多。

        · 08:30  外科学(2)          综教808
        · 10:20  中医骨伤科学       新课室202

    行高 26dp + 间距 2dp：7 行 = 194dp，加上表头仍小于 4x4 的 250dp，
    多出来的高度留在底部，不参与分配（weight 会让每行都变高，反而难看）。

    圆角用 c（13dp），26dp 高的行正好被 clamp 成胶囊。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dim"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/widget_refresh"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tl1"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_kc1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tl1_time"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dim"
                android:textSize="9.5sp" />

            <FrameLayout
                android:id="@+id/tl1_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/widget_dot1" />

            <TextView
                android:id="@+id/tl1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tl1_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="60dp"
                android:textColor="@color/widget_text_weak"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tl2"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_kc1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tl2_time"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dim"
                android:textSize="9.5sp" />

            <FrameLayout
                android:id="@+id/tl2_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/widget_dot1" />

            <TextView
                android:id="@+id/tl2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tl2_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="60dp"
                android:textColor="@color/widget_text_weak"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
